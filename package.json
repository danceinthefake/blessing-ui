{
  "name": "blessing-ui",
  "version": "0.10.0",
  "description": "Blessing UI — Themed Flat Interface. Flat by design, raised with Vue, blessed for everyone.",
  "keywords": [
    "components",
    "design-system",
    "design-tokens",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://ui.blessing.id",
  "bugs": "https://github.com/danceinthefake/blessing-ui/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danceinthefake/blessing-ui.git"
  },
  "bin": {
    "blessing-ui": "./bin/blessing-ui.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md",
    "tokens.css",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./style.css": "./dist/blessing-ui.css",
    "./tokens.css": "./tokens.css",
    "./components/*": {
      "types": "./dist/components/*.vue.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build",
    "typecheck": "vue-tsc --noEmit",
    "format": "oxfmt .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm docs:meta && pnpm docs:blocks && node --max-old-space-size=6144 node_modules/vitepress/bin/vitepress.js build docs",
    "docs:preview": "vitepress preview docs",
    "docs:meta": "node docs/scripts/meta.ts",
    "docs:pages": "node docs/scripts/pages.ts",
    "e2e": "node e2e/sweep.mjs chromium,firefox && node e2e/axe.mjs && node e2e/motion.mjs && node e2e/interact.mjs chromium && node e2e/interact.mjs firefox && node e2e/blocks.mjs chromium && node e2e/blocks.mjs firefox",
    "e2e:consumer": "pnpm build && node e2e/consumer/check.mjs",
    "docs:blocks": "node docs/scripts/blocks.ts",
    "docs:shots": "node docs/scripts/shots.mjs"
  },
  "devDependencies": {
    "@nuxt/kit": "4.6.4",
    "@nuxt/schema": "4.6.4",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "@tiptap/vue-3": "^3.33.1",
    "@types/node": "^26.6.6",
    "@unovis/ts": "^1.8.1",
    "@unovis/vue": "^1.8.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.1",
    "marked": "^18.2.0",
    "oxfmt": "^0.78.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-component-meta": "^3.3.14",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.15 || ^4",
    "@tiptap/vue-3": "^3",
    "marked": "^18",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/vue-3": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "marked": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
