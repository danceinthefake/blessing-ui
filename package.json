{
  "name": "blessing-ui",
  "version": "0.0.1",
  "description": "Blessing UI — Vue 3 components and design tokens",
  "license": "MIT",
  "files": [
    "dist",
    "tokens.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/blessing-ui.js",
  "module": "./dist/blessing-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/blessing-ui.js"
    },
    "./style.css": "./dist/blessing-ui.css",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "oxfmt ."
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
