{
  "name": "blessing-ui",
  "version": "0.0.1",
  "description": "Blessing UI \u2014 Themed Flat Interface. Flat by design, raised with Vue, blessed for everyone.",
  "license": "MIT",
  "files": [
    "dist",
    "tokens.css",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/blessing-ui.css",
    "./tokens.css": "./tokens.css",
    "./components/*": {
      "types": "./dist/components/*.vue.d.ts",
      "import": "./dist/components/*.js"
    }
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vue-tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "oxfmt .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "pnpm docs:meta && pnpm docs:blocks && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:meta": "node docs/scripts/meta.ts",
    "docs:pages": "node docs/scripts/pages.ts",
    "e2e": "node e2e/sweep.mjs chromium,firefox && node e2e/axe.mjs && node e2e/interact.mjs chromium && node e2e/interact.mjs firefox",
    "e2e:consumer": "pnpm build && node e2e/consumer/check.mjs",
    "docs:blocks": "node docs/scripts/blocks.ts",
    "docs:shots": "node docs/scripts/shots.mjs"
  },
  "devDependencies": {
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/vue-3": "^3.31.3",
    "@types/node": "^26.6.1",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.68.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1",
    "vue": "^3.5.0",
    "vue-component-meta": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@tiptap/vue-3": "^3",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/vue-3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2"
}
